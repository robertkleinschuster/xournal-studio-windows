<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XournalStudio.Views.TasksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XournalStudio.Views">
    <UserControl.Resources>
        <MenuFlyout x:Key="TaskMenu">
            <MenuFlyoutItem Text="Bearbeiten…" Click="OnEdit">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Löschen" Click="OnDelete">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>

    <!-- The project folder's todo.txt (the format of todo.txt apps; the file stays as they write it). -->
    <Grid Padding="8,4,8,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="FileName" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"
                   Text="Aufgaben" />

        <!-- New task: Enter adds it (created today); optional due date and link to the page in view. -->
        <StackPanel x:Name="AddPanel" Grid.Row="1" Spacing="4">
            <TextBox x:Name="NewTask" PlaceholderText="Neue Aufgabe (Eingabe fügt hinzu)" KeyDown="OnNewTaskKeyDown"
                     AutomationProperties.Name="Neue Aufgabe" />
            <StackPanel Orientation="Horizontal" Spacing="4">
                <CalendarDatePicker x:Name="NewDue" PlaceholderText="Fällig am" FirstDayOfWeek="Monday"
                                    AutomationProperties.Name="Fällig am" />
                <ToggleButton x:Name="LinkPage" ToolTipService.ToolTip="Mit der Seite im Dokument verknüpfen"
                              AutomationProperties.Name="Mit Seite verknüpfen">
                    <FontIcon Glyph="&#xE71B;" FontSize="16" />
                </ToggleButton>
                <Button x:Name="AddButton" Click="OnAdd" ToolTipService.ToolTip="Hinzufügen" AutomationProperties.Name="Hinzufügen">
                    <SymbolIcon Symbol="Add" />
                </Button>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <ListView x:Name="List" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TaskItem">
                        <Grid ColumnSpacing="4" Padding="0,2" ContextFlyout="{StaticResource TaskMenu}"
                              AutomationProperties.Name="{x:Bind Title}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsDone}" Click="OnDoneClick" MinWidth="0"
                                      AutomationProperties.Name="{x:Bind Title}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" TextDecorations="{x:Bind Decorations}"
                                           Foreground="{x:Bind TitleBrush}" />
                                <TextBlock Text="{x:Bind DueText}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{x:Bind DueBrush}" Visibility="{x:Bind HasDue}" />
                            </StackPanel>
                            <Button Grid.Column="2" Click="OnOpenLink" Visibility="{x:Bind HasLink}"
                                    ToolTipService.ToolTip="{x:Bind LinkText}" AutomationProperties.Name="Verknüpfte Seite öffnen"
                                    Padding="6" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE71B;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="NoFile" Spacing="8" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock x:Name="NoFileText" TextWrapping="Wrap" />
                <Button x:Name="CreateButton" Content="todo.txt anlegen" Click="OnCreate" />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="ShowDone" Grid.Row="3" Content="Erledigte anzeigen" Click="OnShowDoneClick" />
    </Grid>
</UserControl>
