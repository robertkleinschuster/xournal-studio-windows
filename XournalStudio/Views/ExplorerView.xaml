<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XournalStudio.Views.ExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XournalStudio.Views">
    <UserControl.Resources>
        <!-- Context menus (right click, Shift+F10/menu key, press and hold with touch or pen, pen barrel button): one
             for the rows (shared, FlyoutBase.Target is the row), one for the tree's empty area (the project folder). -->
        <MenuFlyout x:Key="ItemMenu" Opening="OnItemMenuOpening">
            <MenuFlyoutItem Tag="file" Text="Öffnen" Click="OnOpenItem">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator Tag="file" />
            <MenuFlyoutItem Text="Neues Dokument" Click="OnNewDocument">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Page2" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Neuer Ordner" Click="OnNewFolder">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="NewFolder" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Umbenennen" KeyboardAcceleratorTextOverride="F2" Click="OnRename">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Rename" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Löschen" KeyboardAcceleratorTextOverride="Entf" Click="OnDelete">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Tag="modified" Text="Änderungen verwerfen" Click="OnDiscard">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Undo" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Im Explorer anzeigen" Click="OnShowInExplorer">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC50;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Als Pfad kopieren" KeyboardAcceleratorTextOverride="Strg+Umschalt+C" Click="OnCopyPath">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE62F;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <MenuFlyout x:Key="FolderMenu" Opening="OnFolderMenuOpening">
            <MenuFlyoutItem Text="Neues Dokument" Click="OnNewDocument">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Page2" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Neuer Ordner" Click="OnNewFolder">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="NewFolder" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Im Explorer anzeigen" Click="OnShowInExplorer">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC50;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Als Pfad kopieren" Click="OnCopyPath">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE62F;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="8,4,4,4" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FolderName" Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Kein Ordner" />
            <Grid Grid.Column="1">
                <AppBarButton x:Name="SyncButton" Icon="Sync" LabelPosition="Collapsed" Label="Synchronisieren"
                              ToolTipService.ToolTip="Synchronisieren: alles committen, holen (rebase), hochladen"
                              Click="OnSync" IsEnabled="False" />
                <ProgressRing x:Name="SyncProgress" Width="20" Height="20" IsActive="False" IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- The tree's own accelerators (focus in the tree) come before the window's (Del = delete the ink selection). -->
        <TreeView x:Name="Tree" Grid.Row="1" SelectionMode="Single" CanDragItems="False" CanReorderItems="False"
                  AllowDrop="False" ItemInvoked="OnItemInvoked" ContextFlyout="{StaticResource FolderMenu}"
                  KeyboardAcceleratorPlacementMode="Hidden">
            <TreeView.KeyboardAccelerators>
                <KeyboardAccelerator Key="F2" Invoked="OnRenameKey" />
                <KeyboardAccelerator Key="Delete" Invoked="OnDeleteKey" />
                <KeyboardAccelerator Modifiers="Control,Shift" Key="C" Invoked="OnCopyPathKey" />
            </TreeView.KeyboardAccelerators>
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:ExplorerItem">
                    <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind Name}" ContextFlyout="{StaticResource ItemMenu}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                            <Grid>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind IsUnchanged, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                           Visibility="{x:Bind IsNew, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{x:Bind IsModified, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
