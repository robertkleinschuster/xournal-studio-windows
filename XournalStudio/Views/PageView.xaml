<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XournalStudio.Views.PageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Sheet" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0.5">
        <Image x:Name="PdfImage" Stretch="Fill" />
        <Path x:Name="Pattern" StrokeThickness="0.5" />
        <!-- Pictures (copied PDF areas, images) lie below the ink, like in Xournal's usual layering. -->
        <Canvas x:Name="ImagesLayer" IsHitTestVisible="False" />
        <InkCanvas x:Name="Canvas" />
        <!-- Lasso, selection rectangle and shape preview of the custom tools (input arrives on the Sheet). -->
        <Canvas x:Name="ToolLayer" IsHitTestVisible="False" />
    </Grid>
</UserControl>
