<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XournalStudio.Views.PagesPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XournalStudio.Views">
    <UserControl.Resources>
        <!-- The actions on one page (right-click; with the pen a tap with the barrel button held). -->
        <MenuFlyout x:Key="PageMenu">
            <MenuFlyoutItem Text="Leere Seite davor einfügen" Click="OnInsertBefore" />
            <MenuFlyoutItem Text="Leere Seite danach einfügen" Click="OnInsertAfter">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Seiten aus PDF oder Dokument einfügen…" Click="OnInsertFromFile">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Nach oben" Click="OnMoveUp">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Up" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Nach unten" Click="OnMoveDown">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Seite löschen…" Click="OnDelete">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>

    <!-- The document's pages as thumbnails: tap = go to the page; insert, move, delete. -->
    <Grid Padding="8,4,8,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- As tall as the other tabs' header rows: switching tabs keeps the header in place. -->
        <StackPanel MinHeight="48" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <AppBarButton Width="44" LabelPosition="Collapsed" Label="Leere Seite danach einfügen" AllowFocusOnInteraction="False"
                          ToolTipService.ToolTip="Leere Seite nach der gewählten einfügen" Click="OnInsertAfter">
                <AppBarButton.Icon><SymbolIcon Symbol="Add" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Width="44" LabelPosition="Collapsed" Label="Seiten aus PDF oder Dokument einfügen" AllowFocusOnInteraction="False"
                          ToolTipService.ToolTip="Seiten aus einem PDF (z. B. ein Deckblatt) oder einem anderen Dokument einfügen" Click="OnInsertFromFile">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8A5;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Width="44" LabelPosition="Collapsed" Label="Nach oben" AllowFocusOnInteraction="False"
                          ToolTipService.ToolTip="Gewählte Seite nach oben" Click="OnMoveUp">
                <AppBarButton.Icon><SymbolIcon Symbol="Up" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Width="44" LabelPosition="Collapsed" Label="Nach unten" AllowFocusOnInteraction="False"
                          ToolTipService.ToolTip="Gewählte Seite nach unten" Click="OnMoveDown">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Width="44" LabelPosition="Collapsed" Label="Seite löschen" AllowFocusOnInteraction="False"
                          ToolTipService.ToolTip="Gewählte Seite löschen" Click="OnDelete">
                <AppBarButton.Icon><SymbolIcon Symbol="Delete" /></AppBarButton.Icon>
            </AppBarButton>
        </StackPanel>

        <!-- Reordering by dragging (finger or mouse); with the pen the buttons and the menu. -->
        <ListView x:Name="List" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsStarting="OnDragItemsStarting"
                  DragItemsCompleted="OnDragItemsCompleted" ContextFlyout="{StaticResource PageMenu}"
                  ContextRequested="OnContextRequested">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PageThumb">
                    <StackPanel Padding="4,8" Spacing="4" HorizontalAlignment="Center">
                        <!-- Two layers: the background PDF's page, and what lies on it (ink, pictures, texts). -->
                        <Border Width="{x:Bind Width}" Height="{x:Bind Height}" Background="White"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Image Source="{x:Bind Background, Mode=OneWay}" Stretch="Fill" />
                                <Image Source="{x:Bind Content, Mode=OneWay}" Stretch="Fill" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{x:Bind Number, Mode=OneWay}" HorizontalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
