<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XournalStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:XournalStudio.Views"
    Title="Xournal Studio">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Datei">
                <MenuFlyoutItem Text="Neu" Click="OnNew">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Page2" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Öffnen…" Click="OnOpen">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Speichern" Click="OnSave">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Save" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Speichern unter…" Click="OnSaveAs">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Ordner öffnen…" Click="OnOpenFolder">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Folder" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="SyncMenuItem" Text="Synchronisieren" Click="OnSync" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Sync" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Bearbeiten">
                <MenuFlyoutItem x:Name="UndoMenuItem" Text="Rückgängig" Click="OnUndo">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Undo" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="RedoMenuItem" Text="Wiederholen" Click="OnRedo">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Redo" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Y" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Kopieren" Click="OnCopy">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="C" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Auswahl löschen" Click="OnDeleteSelection">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Einfügen" Click="OnPaste">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Paste" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="V" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Seite">
                <MenuFlyoutItem Text="Seite einfügen" Click="OnInsertPage">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Seite löschen" Click="OnDeletePage">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Ansicht">
                <ToggleMenuFlyoutItem x:Name="ExplorerMenuItem" Text="Explorer" Click="OnToggleExplorer">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="B" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Seitenbreite" Click="OnFitWidth">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Number0" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Vergrößern" Click="OnZoomIn">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="ZoomIn" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Add" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Verkleinern" Click="OnZoomOut">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="ZoomOut" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Subtract" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <!-- Single toolbar, everything left-aligned (nothing at the right edge). -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Padding="8,0,8,4">
            <AppBarToggleButton x:Name="ExplorerButton" LabelPosition="Collapsed" Label="Explorer"
                                ToolTipService.ToolTip="Explorer ein-/ausblenden (Strg+B)" Click="OnToggleExplorer">
                <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8A0;" /></AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarSeparator />
            <InkToolbar x:Name="Toolbar" InitialControls="None" VerticalAlignment="Center">
                <InkToolbarBallpointPenButton x:Name="PenButton" AutomationProperties.Name="Stift" />
                <InkToolbarHighlighterButton x:Name="HighlighterButton" AutomationProperties.Name="Textmarker" />
                <InkToolbarEraserButton x:Name="EraserButton" IsClearAllVisible="False" ToolTipService.ToolTip="Radierer" AutomationProperties.Name="Radierer" />
                <!-- Windows' own ruler and protractor: draw along the edge for straight lines; move/turn with fingers. -->
                <InkToolbarStencilButton x:Name="StencilButton" ToolTipService.ToolTip="Lineal / Geodreieck" AutomationProperties.Name="Lineal" />
                <!-- Custom tools (Microsoft's InkToolbar extension point); the ink takes no input while one is active. -->
                <InkToolbarCustomToolButton x:Name="LassoButton" ToolTipService.ToolTip="Auswählen (Lasso): umfahren, dann verschieben; Entf löscht, Strg+C kopiert" AutomationProperties.Name="Auswählen">
                    <FontIcon Glyph="&#xF1BE;" />
                </InkToolbarCustomToolButton>
                <InkToolbarCustomToolButton x:Name="ShapeButton" ToolTipService.ToolTip="Formen: Linie, Pfeil, Rechteck, Ellipse (nochmal tippen zum Wählen)" AutomationProperties.Name="Formen">
                    <InkToolbarCustomToolButton.ConfigurationContent>
                        <RadioButtons x:Name="ShapeChoice" Header="Form" SelectionChanged="OnShapeChoiceChanged">
                            <x:String>Linie</x:String>
                            <x:String>Pfeil</x:String>
                            <x:String>Rechteck</x:String>
                            <x:String>Ellipse</x:String>
                        </RadioButtons>
                    </InkToolbarCustomToolButton.ConfigurationContent>
                    <!-- Line, rectangle, circle as outlines (PathIcon fills, so even-odd rings). -->
                    <PathIcon Data="F0 M1,17.9 L7.9,11 L9,12.1 L2.1,19 Z M10,1 H19 V10 H10 Z M11.5,2.5 V8.5 H17.5 V2.5 Z M10,15 A4.5,4.5 0 1 0 19,15 A4.5,4.5 0 1 0 10,15 Z M11.5,15 A3,3 0 1 1 17.5,15 A3,3 0 1 1 11.5,15 Z" />
                </InkToolbarCustomToolButton>
                <InkToolbarCustomToolButton x:Name="PdfAreaButton" ToolTipService.ToolTip="PDF-Bereich kopieren: Rechteck ziehen, dann mit Strg+V auf einer Seite einfügen" AutomationProperties.Name="PDF-Bereich kopieren">
                    <FontIcon Glyph="&#xF407;" />
                </InkToolbarCustomToolButton>
                <InkToolbarCustomToggleButton x:Name="RecognizeButton" AutomationProperties.Name="Formerkennung" ToolTipService.ToolTip="Formerkennung">
                    <FontIcon Glyph="&#xF4A5;" />
                </InkToolbarCustomToggleButton>
            </InkToolbar>
            <AppBarButton x:Name="PasteButton" LabelPosition="Collapsed" Label="Einfügen" ToolTipService.ToolTip="Bild einfügen (Strg+V), z. B. einen Ausschnitt aus dem Ausschneidetool (Win+Umschalt+S)" Click="OnPaste">
                <AppBarButton.Icon><FontIcon Glyph="&#xE77F;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="InsertPageButton" Icon="Add" LabelPosition="Collapsed" Label="Seite einfügen"
                          ToolTipService.ToolTip="Seite einfügen" Click="OnInsertPage" />
            <AppBarButton Icon="Delete" LabelPosition="Collapsed" Label="Seite löschen"
                          ToolTipService.ToolTip="Seite löschen" Click="OnDeletePage" />
            <AppBarSeparator />
            <AppBarButton x:Name="UndoButton" Icon="Undo" LabelPosition="Collapsed" Label="Rückgängig"
                          ToolTipService.ToolTip="Rückgängig" Click="OnUndo" IsEnabled="False" />
            <AppBarButton x:Name="RedoButton" Icon="Redo" LabelPosition="Collapsed" Label="Wiederholen"
                          ToolTipService.ToolTip="Wiederholen" Click="OnRedo" IsEnabled="False" />
        </StackPanel>

        <!-- The explorer is on the left (right-handed: the right edge stays free). -->
        <SplitView x:Name="Split" Grid.Row="2" DisplayMode="Inline" OpenPaneLength="300"
                   PaneBackground="Transparent" IsPaneOpen="False">
            <SplitView.Pane>
                <views:ExplorerView x:Name="Explorer" />
            </SplitView.Pane>
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <ScrollView x:Name="Scroller" IsTabStop="True" IgnoredInputKinds="Pen" ZoomMode="Enabled" ContentOrientation="Vertical"
                            MinZoomFactor="0.2" MaxZoomFactor="6"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                            ViewChanged="OnViewChanged" SizeChanged="OnScrollerSizeChanged">
                    <StackPanel x:Name="PagesPanel" Spacing="16" Padding="16" HorizontalAlignment="Center" />
                </ScrollView>
                <InfoBar x:Name="Info" VerticalAlignment="Top" Margin="16" IsOpen="False" />
            </Grid>
        </SplitView>
    </Grid>
</Window>
