{
  "version": 11,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja Multi-Config, ccache",
      "description": "The project's build: Ninja Multi-Config, the own code through ccache, third-party libraries from vcpkg (manifest mode, triplet x64-windows-static, binary cache). Needs the x64 developer environment (build.ps1 and Visual Studio's CMake support enter it; Ninja is on its PATH) and the environment variable VCPKG_ROOT.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/.local-build/cmake",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "XOURNAL_CCACHE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/.local-build/ctest-junit.xml"
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": ""
      },
      "filter": {
        "exclude": {
          "name": "^InkPagesTests_NOT_BUILT$"
        }
      }
    },
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/.local-build/ctest-junit.xml"
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": ""
      },
      "filter": {
        "exclude": {
          "name": "^InkPagesTests_NOT_BUILT$"
        }
      }
    }
  ]
}
