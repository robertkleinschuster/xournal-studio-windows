<!--
  Per-user MSI of Xournal Studio (Win32) (WiX Toolset, see Build-Msi.ps1). No admin rights, no dialogs (Windows
  Installer's progress window only). Installs the staged app (install.ps1 -SkipInstall: XournalStudio.exe, pdfium.dll,
  licenses\, THIRD-PARTY.md, README.txt) to %LOCALAPPDATA%\Programs\Xournal Studio (Win32) - the folder install.ps1
  uses, which refuses while this package is installed - plus the Start menu shortcut "Xournal Studio (Win32)".
  Uninstall removes exactly that; the user's settings, recovery copies and documents are never touched.
  The UpgradeCode never changes: a newer version replaces the installed one (MajorUpgrade).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Xournal Studio (Win32)"
           Manufacturer="Robert Kleinschuster"
           Version="$(Version)"
           UpgradeCode="2ED20F25-015E-4F3B-9B2A-7572D4BBBB6A"
           Scope="perUser"
           Language="1031"
           Codepage="1252">
    <SummaryInformation Description="Xournal Studio (Win32) $(Version)" />
    <MajorUpgrade DowngradeErrorMessage="Eine neuere Version von Xournal Studio (Win32) ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Apps & Features: icon, publisher (Manufacturer), version; no "Ändern" (there is nothing to choose). -->
    <Icon Id="AppIcon" SourceFile="$(AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Xournal Studio (Win32)" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(Stage)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="Xournal Studio (Win32)" Target="[INSTALLFOLDER]XournalStudio.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <!-- A per-user component needs a registry key path; removed with the package. -->
        <RegistryValue Root="HKCU" Key="Software\Xournal Studio (Win32)\Installer" Name="Shortcut" Type="integer"
                       Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
