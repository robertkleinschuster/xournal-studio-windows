<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <NoWarn>$(NoWarn);CS8305</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The file format code has no UI dependencies beyond the ink types. -->
    <Compile Include="..\XournalStudio\Model\*.cs" Link="Model\%(Filename)%(Extension)" />
    <!-- Explorer logic without UI. -->
    <Compile Include="..\XournalStudio\Services\ProjectTree.cs" Link="Services\ProjectTree.cs" />
    <Compile Include="..\XournalStudio\Services\GitSync.cs" Link="Services\GitSync.cs" />
    <Compile Include="..\XournalStudio\Services\ProjectFiles.cs" Link="Services\ProjectFiles.cs" />
    <Compile Include="..\XournalStudio\Services\FolderWatcher.cs" Link="Services\FolderWatcher.cs" />
    <Compile Include="..\XournalStudio\Services\DebugLog.cs" Link="Services\DebugLog.cs" />
    <!-- Crash recovery copies. -->
    <Compile Include="..\XournalStudio\Services\Recovery.cs" Link="Services\Recovery.cs" />
    <Compile Include="..\XournalStudio\Services\AppSettings.cs" Link="Services\AppSettings.cs" />
    <!-- Tasks (todo.txt). -->
    <Compile Include="..\XournalStudio\Services\TaskFile.cs" Link="Services\TaskFile.cs" />
    <!-- PDF export. -->
    <Compile Include="..\XournalStudio\Services\PdfExport.cs" Link="Services\PdfExport.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.6-experimental" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.6-experimental" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
