<Project Sdk="Microsoft.NET.Sdk">
  <!-- The library's demo and development app: pages with the whole toolbar and all tools, without any file format.
       Used to design the toolbar (screenshots of every state) and to test the library in Windows Sandbox (UiTests\). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>InkPages.Demo</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Makes dotnet publish include the app's .pri and .xbf files. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The ink controls are marked experimental. -->
    <NoWarn>$(NoWarn);CS8305;WMC1501</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InkPages\InkPages.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.6-experimental" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.6-experimental" />
  </ItemGroup>
  <Import Project="..\build\WinUIForkRuntime.targets" />
</Project>
